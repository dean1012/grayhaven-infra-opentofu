#cloud-config

write_files:
  - path: /etc/grayhaven/bootstrap/bootstrap-vars.yml
    owner: root:root
    permissions: '0600'
    content: |
      ${indent(6, bootstrap_vars_yaml)}

packages:
  - ansible-core

# OpenTofu validates the checkout ref before rendering this cloud-init handoff.
# Keep this command as the only bootstrap action; ongoing convergence is owned by
# grayhaven-config-ansible after the bootstrap playbook installs the runner.
runcmd:
  - ansible-pull --url https://github.com/dean1012/grayhaven-config-ansible.git --checkout ${config_repo_ref} --inventory localhost, --connection local --extra-vars @/etc/grayhaven/bootstrap/bootstrap-vars.yml playbooks/bootstrap.yml
